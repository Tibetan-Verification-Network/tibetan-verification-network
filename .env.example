# Local development only. Copy to .env when you need to override a value:
#   cp .env.example .env
# Never commit .env. The password below is a non-production placeholder.
# Compose rejects this password if ENVIRONMENT=production.

ENVIRONMENT=development
LOG_LEVEL=info

# Host-side API (uv run tvn-api). Compose rewrites the host to "postgres".
DATABASE_URL=postgresql://tvn:tvn_local_dev@localhost:5432/tvn
POSTGRES_USER=tvn
POSTGRES_PASSWORD=tvn_local_dev
POSTGRES_DB=tvn

# Comma-separated browser origins. No wildcard and no credentials in the origin.
# Both loopback names are listed because the site may be opened as either one.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Fixed published ports, bound to 127.0.0.1: PostgreSQL 5432, API 8000, frontend 5173.
VITE_API_BASE_URL=http://localhost:8000
READINESS_TIMEOUT_SECONDS=2

# Staff session and invite defaults (hours).
SESSION_TTL_HOURS=168
INVITE_TTL_HOURS=168
# API and staff login/activate forms (Compose maps this to VITE_PASSWORD_MIN_LENGTH for the frontend).
PASSWORD_MIN_LENGTH=12

# Public submission abuse controls (Postgres-backed counters; no Redis).
SUBMISSION_MAX_BODY_BYTES=32768
SUBMISSION_RATE_LIMIT_IP_MAX=20
SUBMISSION_RATE_LIMIT_IP_WINDOW_SECONDS=3600
SUBMISSION_RATE_LIMIT_GLOBAL_MAX=500
SUBMISSION_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=3600
SUBMISSION_DUPLICATE_SIMILARITY_THRESHOLD=0.35
# Use a long random value in production (see Settings validation).
SUBMISSION_SUBMITTER_HMAC_KEY=local-dev-submitter-hmac-key
SUBMISSION_CAPTCHA_ENABLED=false
# TURNSTILE_SECRET_KEY=   # required when SUBMISSION_CAPTCHA_ENABLED=true

# Behind a reverse proxy in production (submission rate limits use client IP):
# TRUST_FORWARDED_FOR=true
# PROXY_HEADERS=true
# TRUSTED_HOSTS=api.example.org

# Optional error monitoring (install sentry-sdk[fastapi] in the API environment):
# SENTRY_DSN=

# Private archive object storage (MinIO in Compose; S3-compatible in production).
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_BUCKET=tvn-archive
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_REGION=us-east-1
ARCHIVE_MAX_UPLOAD_BYTES=26214400
ARCHIVE_SIGNED_URL_TTL_SECONDS=120
